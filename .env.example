# Vertex AI through Application Default Credentials — no API keys.
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=eu
GOOGLE_GENAI_USE_VERTEXAI=True

# System ffmpeg/ffprobe directory (used by absolute path, never PATH)
FFMPEG_DIR=C:\ffmpeg-7.1.1-essentials_build\bin

# Remotion company licence key (leave empty for individuals / teams of up to 3)
REMOTION_LICENSE_KEY=

# Bearer token the web app sends to the API
APP_TOKEN=change-me

# Hard spend cap per graph run (USD)
MAX_RUN_COST_USD=2.0
